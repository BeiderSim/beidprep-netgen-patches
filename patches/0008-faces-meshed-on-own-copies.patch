+  // BeidPrep new-mesher patch 0008: every face meshed and optimised on its own copy.
+  //
+  // Each face that MeshSurface would mesh is meshed (MeshFace) and then optimised (the steps
+  // of OptimizeSurface, for this face only) on its OWN copy of the mesh as it stands when
+  // surface meshing starts: the same points, edge segments and descriptors, with the local
+  // size tree shared read-only (Meshing2 leaves it alone when mparam.facethreads > 0, which
+  // does not change any size it returns - see meshing2.cpp).  The copies are then merged
+  // into the mesh one face after the other, in face order.  No face sees another face's
+  // elements, so the mesh is the same whatever the order in which the faces were done and
+  // however many threads did them (mparam.facethreads).
+  static bool FacewiseFaceCopy (const Mesh & mesh, Mesh & fm, size_t nfaces_layers)
+  {
+    fm.SetGeometry (mesh.GetGeometry());
+    fm.SetDimension (mesh.GetDimension());
+    fm.SetGlobalH (mesh.GetGlobalH());
+    fm.SetMinimalH (mesh.GetMinimalH());
+    for (int layer = 1; layer <= int(nfaces_layers); layer++)
+      fm.SetLocalH (mesh.GetLocalH(layer), layer);
+    fm.Points() = mesh.Points();
+    fm.LineSegments() = mesh.LineSegments();
+    for (const auto & ed : mesh.EdgeDescriptors())
+      fm.AddEdgeDescriptor (ed);
+    for (const auto & fd : mesh.Regions<2>())
+      fm.AddFaceDescriptor (fd);
+    fm.ClearSurfaceElements();        // the copied descriptors must not point at mesh's elements
+    // every point of the mesh stays where it is in the copy (a Compress after a failed
+    // meshing attempt would otherwise renumber them); they are fixed edge and vertex points
+    // or points of other faces, so this changes nothing for the face meshed here
+    for (PointIndex pi : mesh.Points().Range())
+      fm.AddLockedPoint (pi);
+    return true;
+  }
+
+  void NetgenGeometry :: MeshSurfaceFacewise(Mesh& mesh, const MeshingParameters& mparam) const
+  {
+    static Timer t1("Surface Meshing (facewise)"); RegionTimer regt(t1);
+    const char* savetask = multithread.task;
+    multithread.task = "Mesh Surface";
+    mesh.ClearFaceDescriptors();
+
+    for(auto k : Range(faces))
+    {
+        auto & face = *faces[k];
+        FaceRegion fd(k+1, face.domin+1, face.domout+1, k+1);
+        if(face.properties.col)
+          fd.SetSurfColour(*face.properties.col);
+        mesh.AddFaceDescriptor(fd);
+        mesh.SetBCName(k, face.properties.GetName());
+    }
+
+    int max_index = mesh.GetNFD();
+    for(const auto & sel : mesh.SurfaceElements())
+        max_index = max2(max_index, sel.GetIndex().Nr1());
+    while(mesh.GetNFD() < max_index)
+    {
+        FaceRegion fd(mesh.GetNFD()+1, 0, 0, -1);
+        mesh.AddFaceDescriptor(fd);
+    }
+
+    prefilled_faces.assign(faces.Size(), false);        // patch 0004, as in MeshSurface
+    for(const auto & sel : mesh.SurfaceElements())
+      {
+        int k = sel.GetIndex().Nr1() - 1;
+        if(k >= 0 && k < (int)faces.Size() && !sel.IsDeleted())
+          prefilled_faces[k] = true;
+      }
+
+    Array<int> todo;
+    size_t nlayers = 1;
+    for(auto k : Range(faces))
+      {
+        nlayers = max2(nlayers, size_t(max2(1, faces[k]->properties.layer)));
+        if(!prefilled_faces[k])
+          todo.Append(k);
+      }
+
+    const int np0 = mesh.GetNP();
+    const bool optimize = mparam.perfstepsend >= MESHCONST_OPTSURFACE;
+
+    // what one face leaves behind: its new points (numbered after the mesh's np0 points)
+    // and its elements, which use mesh points and these new points
+    struct FaceResult
+    {
+      Array<MeshPoint> newpoints;
+      Array<Element2d> elements;
+      bool failed = false;
+      std::exception_ptr error;
+    };
+    std::vector<FaceResult> res(todo.Size());
+
+    auto run_parallel = [&] (auto && task)
+    {
+      int nthreads = max2(1, min2(mparam.facethreads, int(todo.Size())));
+      std::atomic<int> next(0);
+      auto worker = [&] ()
+      {
+        for (int i = next++; i < int(todo.Size()); i = next++)
+          {
+            try { task(i); }
+            catch (...) { res[i].error = std::current_exception(); }
+          }
+      };
+      if (nthreads == 1)
+        worker();
+      else
+        {
+          std::vector<std::thread> threads;
+          for (int t = 0; t < nthreads; t++)
+            threads.emplace_back(worker);
+          for (auto & th : threads)
+            th.join();
+        }
+      for (auto & r : res)                    // first error in face order, as a serial loop
+        if (r.error)
+          std::rethrow_exception(r.error);
+    };
+
+    auto take = [&] (Mesh & fm, FaceResult & r)
+    {
+      r.newpoints.SetSize(0);
+      for (int i = np0; i < fm.GetNP(); i++)
+        r.newpoints.Append(fm.Points()[PointIndex::FromNr0(i)]);
+      r.elements.SetSize(0);
+      for (SurfaceElementIndex sei : fm.SurfaceElements().Range())
+        if (!fm[sei].IsDeleted())
+          r.elements.Append(Element2d(fm[sei]));
+    };
+
+    // 1. mesh every face on its own copy
+    run_parallel ([&] (int i)
+    {
+      int k = todo[i];
+      Mesh fm;
+      FacewiseFaceCopy (mesh, fm, nlayers);
+      Array<int, PointIndex> glob2loc(fm.GetNP());
+      res[i].failed = MeshFace(fm, mparam, k, glob2loc);
+      take (fm, res[i]);
+    });
+
+    size_t n_failed_faces = 0;
+    for (auto & r : res)
+      if (r.failed)
+        n_failed_faces++;
+    if(n_failed_faces)
+    {
+        cout << "WARNING! NOT ALL FACES HAVE BEEN MESHED" << endl;
+        cout << "SURFACE MESHING ERROR OCCURRED IN " << n_failed_faces << " FACES:" << endl;
+    }
+    bool stop = n_failed_faces && mparam.facetimeout <= 0;    // as MeshSurface: no optimisation
+
+    // 2. optimise every face on its own copy (OptimizeSurface's steps, this face only)
+    if (optimize && !stop)
+      run_parallel ([&] (int i)
+      {
+        int k = todo[i];
+        auto & r = res[i];
+        if (!r.elements.Size())
+          return;
+        Mesh fm;
+        FacewiseFaceCopy (mesh, fm, nlayers);
+        for (auto & mp : r.newpoints)
+          fm.Points().Append(mp);
+        for (auto & el : r.elements)
+          fm.AddSurfaceElement(el);
+        fm.SetNextTimeStamp();
+        fm.FindIllegalTrigs();
+        fm.CalcSurfacesOfNode();
+        MeshOptimize2d meshopt(fm);
+        auto fi = FaceRegionIndex::FromNr0(k);
+        for(auto step : Range(mparam.optsteps2d))
+          {
+            (void)step;
+            meshopt.SetFaceIndex(fi);
+            meshopt.SetMetricWeight (mparam.elsizeweight);
+            for(auto optstep : mparam.optimize2d)
+              switch(optstep)
+                {
+                case 's': meshopt.EdgeSwapping(0); break;
+                case 'S': meshopt.EdgeSwapping(1); break;
+                case 'm': meshopt.ImproveMesh(mparam); break;
+                case 'c': meshopt.CombineImprove(); break;
+                }
+          }
+        take (fm, r);
+      });
+
+    // 3. merge in face order: each face's new points that its elements use, in their order
+    for (auto & r : res)
+      {
+        Array<bool> used(r.newpoints.Size());
+        used = false;
+        for (auto & el : r.elements)
+          for (auto pi : el.PNums())
+            if (pi.Nr0() >= np0)
+              used[pi.Nr0() - np0] = true;
+        Array<PointIndex> newnr(r.newpoints.Size());
+        for (auto j : Range(r.newpoints))
+          if (used[j])
+            {
+              mesh.Points().Append(r.newpoints[j]);
+              newnr[j] = PointIndex::FromNr0(mesh.GetNP() - 1);
+            }
+        for (auto & el : r.elements)
+          {
+            Element2d el2(el);
+            for (int j = 1; j <= el2.GetNP(); j++)
+              if (el2.PNum(j).Nr0() >= np0)
+                el2.PNum(j) = newnr[el2.PNum(j).Nr0() - np0];
+            mesh.AddSurfaceElement(el2);
+          }
+      }
+    mesh.SetNextTimeStamp();
+
+    if (stop)
+      return;
+    if (optimize)
+      {
+        mesh.CalcSurfacesOfNode();
+        mesh.Compress();
+      }
+    mesh.CalcSurfacesOfNode();
+    multithread.task = savetask;
+  }
